# Copy this file to `.env` and fill in what you need. Every value is optional.
# Never commit `.env` (it is in .gitignore) and never put these values in frontend code.

# ---------- Server ----------
# Port for the single web + API server.
PORT=4000
# Public address of the app, used for the links inside emails.
# Defaults to http://localhost:<PORT>.
# APP_URL=http://localhost:4000
# Where the SQLite database and uploaded images are stored.
DATA_DIR=data
# Add the starting set of member profiles when the database is first created.
DEMO_MODE=true
# How long a login session lasts.
SESSION_DAYS=14
# Mark the session cookie Secure. Defaults to true when APP_URL starts with https://.
# COOKIE_SECURE=false

# ---------- Email ----------
# Easiest: Gmail. Fill in these two lines and Nexly sends its emails (password reset,
# connection requests) to people's own inboxes. Steps:
#   1. Turn on 2-Step Verification for the Google account: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an app password: https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below (spaces are fine), then restart the server.
#   4. Check delivery:  npm run email:test -- you@example.com
# GMAIL_USER=your.address@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Which provider to use: gmail | smtp | resend | dev. Left empty, the app picks whichever has
# credentials below. With none, emails are kept in the inbox page at /inbox on this computer.
# EMAIL_PROVIDER=
# The sender shown on emails. Gmail always sends as GMAIL_USER.
# EMAIL_FROM=Nexly <no-reply@yourdomain.com>

# Any other SMTP server (instead of the Gmail shortcut).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Resend (https://resend.com) instead of SMTP.
# RESEND_API_KEY=
