{
  "name": "nexly",
  "version": "1.0.0",
  "private": true,
  "description": "Nexly — a professional network discovery platform. Find relevant people faster with concise profile cards ranked by relevance.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:watch": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts --production",
    "seed": "tsx server/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:e2e": "tsx scripts/e2e.ts",
    "email:test": "tsx scripts/send-test-email.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.49.0",
    "nodemailer": "^10.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
